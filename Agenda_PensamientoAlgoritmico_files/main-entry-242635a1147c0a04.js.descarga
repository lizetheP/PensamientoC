              nodes {
                currentScore
                finalScore
                state
              }
            }
            assignmentsConnection {
              nodes {
                _id
                name
                pointsPossible
                dueAt
                gradingType
                submissionsConnection(
                  filter: { includeUnsubmitted: true, userId: $userId }
                ) {
                  nodes {
                    state
                    late
                    excused
                    missing
                    score
                    grade
                    submissionStatus
                    commentsConnection {
                      nodes {
                        _id
                        read
                      }
                    }
                  }
                }
                submissionTypes
              }
            }
          }
        }
      }
    }
  }
